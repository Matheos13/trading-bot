# Copy to .env and fill in. NEVER commit your real .env.
# Leave blank to run in backtest/synthetic mode (no account needed).

EXCHANGE=binance
API_KEY=
API_SECRET=

# Trading params
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Risk (fractions of equity)
RISK_PER_TRADE=0.02
STOP_LOSS_PCT=0.03

# Set to "paper" until you have tested thoroughly. "live" uses real funds.
MODE=paper
